# Application & User Configuration
UID=1000
GID=1000
APP_NAME=erp-trading
APP_ENV=local
APP_DEBUG=true
APP_URL=http://127.0.0.1:8080

# Web & Vite Port Binding (127.0.0.1 only)
APP_PORT=8080
VITE_PORT=5173

# Database Credentials & Configuration (MariaDB 12.3 LTS)
DB_HOST=db
DB_PORT=3306
DB_DATABASE=erp_trading
DB_DATABASE_TEST=erp_trading_test

# Root Password for Container Initialization
DB_ROOT_PASSWORD=change_this_to_a_secure_random_root_password

# Application User (DML strictly: SELECT, INSERT, UPDATE, DELETE)
DB_APP_USERNAME=erp_app
DB_APP_PASSWORD=change_this_to_a_secure_random_app_password

# Migrator User (DDL: CREATE, ALTER, DROP, etc. + DML for migrations)
DB_MIGRATOR_USERNAME=erp_migrator
DB_MIGRATOR_PASSWORD=change_this_to_a_secure_random_migrator_password
