# Infrastructure settings for compose.prod.yaml and scripts/deploy.sh.
# Copy to .env.production on the server and replace every placeholder.
APP_DOMAIN=erp.example.com

# Registry images. ERP_IMAGE_TAG is set by scripts/deploy.sh.
ERP_PHP_IMAGE=ghcr.io/widiartowahyu3/erp-laravel-php
ERP_WEB_IMAGE=ghcr.io/widiartowahyu3/erp-laravel-web

# Published ports
BIND_ADDR=0.0.0.0
HTTP_PORT=80
HTTPS_PORT=443

# Host paths
TLS_CERT_DIR=./certs
ACME_WEBROOT=./certbot-www
APP_ENV_FILE=./.env.app
DB_ROOT_PASSWORD_FILE=./secrets/db_root_password.txt

# Database accounts. DB_APP_PASSWORD must equal DB_PASSWORD in .env.app.
DB_APP_USERNAME=erp_app
DB_APP_PASSWORD=change_this_to_erp_app_password
DB_MIGRATOR_USERNAME=erp_migrator
DB_MIGRATOR_PASSWORD=change_this_to_erp_migrator_password
